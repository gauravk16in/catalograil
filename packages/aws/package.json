{
  "name": "@catalograil/aws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS implementations of the core ports, and in-memory ones for tests",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@catalograil/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/client-ses": "^3.716.0",
    "@aws-sdk/client-sqs": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0"
  },
  "devDependencies": {
    "@catalograil/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
