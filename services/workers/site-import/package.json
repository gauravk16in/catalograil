{
  "name": "@catalograil/worker-site-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQS worker: import a merchant catalogue from their own website",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@catalograil/core": "workspace:*",
    "@catalograil/db": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "@aws-sdk/client-sqs": "^3.716.0",
    "@aws-lambda-powertools/logger": "^2.12.0",
    "@aws-lambda-powertools/metrics": "^2.12.0",
    "@aws-lambda-powertools/tracer": "^2.12.0",
    "@types/aws-lambda": "^8.10.147",
    "drizzle-orm": "^0.38.2",
    "@catalograil/aws": "workspace:*",
    "@catalograil/site-import": "workspace:*",
    "@catalograil/worker-ingestion": "workspace:*"
  },
  "devDependencies": {
    "@catalograil/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "postgres": "^3.4.5"
  }
}
