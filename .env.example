# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
STAGE=dev                        # dev | staging | prod
LOG_LEVEL=INFO                   # Powertools: DEBUG | INFO | WARN | ERROR

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1            # D8: Mumbai primary
AWS_ACCOUNT_ID=
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-south-1

# ─── Aurora Serverless v2 (catalog store, D1) ────────────────────────────────
# Lambdas connect through RDS Proxy with IAM auth — never directly (rule 11).
DATABASE_HOST=localhost          # RDS Proxy endpoint in deployed envs
DATABASE_PORT=5432
DATABASE_NAME=catalograil
DATABASE_USER=catalograil
DATABASE_PASSWORD=               # local dev only; deployed envs use IAM auth
DATABASE_SSL=false               # true in deployed envs
DATABASE_IAM_AUTH=false          # true in deployed envs
DATABASE_URL=postgres://catalograil:catalograil@localhost:5432/catalograil
DATABASE_MAX_CONNECTIONS=5

# ─── DynamoDB (ephemeral store, D2) ──────────────────────────────────────────
DDB_TABLE_SESSIONS=catalograil-dev-sessions
DDB_TABLE_IDEMPOTENCY=catalograil-dev-idempotency-keys
DDB_TABLE_QUERY_CACHE=catalograil-dev-query-cache
DDB_TABLE_ADAPTER_CACHE=catalograil-dev-adapter-cache
DDB_TABLE_SEARCH_LOGS=catalograil-dev-search-logs
DDB_TABLE_RATE_LIMITS=catalograil-dev-rate-limits

# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_UPLOADS=catalograil-dev-uploads
S3_BUCKET_PRODUCT_IMAGES=catalograil-dev-product-images
S3_BUCKET_EXPORTS=catalograil-dev-exports
CLOUDFRONT_IMAGE_DOMAIN=

# ─── SQS ──────────────────────────────────────────────────────────────────────
SQS_QUEUE_INGESTION=
SQS_QUEUE_ENRICHMENT=
SQS_QUEUE_EMBEDDING=
SQS_QUEUE_NOTIFICATION=
SQS_QUEUE_POLICY_CHECK=

# ─── KMS (rule 3: Razorpay tokens are envelope-encrypted at rest) ────────────
KMS_TOKEN_KEY_ID=

# ─── Bedrock embeddings (D5) ─────────────────────────────────────────────────
# Confirm these against packages/embeddings/MODELS.md, produced by T1.2.
BEDROCK_REGION=ap-south-1
BEDROCK_TEXT_EMBED_MODEL_ID=cohere.embed-v4
BEDROCK_IMAGE_EMBED_MODEL_ID=cohere.embed-v4
BEDROCK_EMBED_DIMENSIONS=1024
BEDROCK_EMBED_TYPE=int8
BEDROCK_TEXT_EMBED_FALLBACK_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_IMAGE_EMBED_FALLBACK_MODEL_ID=amazon.titan-embed-image-v1

# ─── Anthropic API (enrichment, policy extraction, chat pane) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_ENRICHMENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_POLICY_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# ─── Razorpay OAuth (D4: payments land on the merchant's own account) ────────
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
RAZORPAY_OAUTH_AUTHORIZE_URL=https://auth.razorpay.com/authorize
RAZORPAY_OAUTH_TOKEN_URL=https://auth.razorpay.com/token
RAZORPAY_OAUTH_REVOKE_URL=https://auth.razorpay.com/revoke
RAZORPAY_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback
RAZORPAY_OAUTH_SCOPES=read_write
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# ─── Sessions and auth ────────────────────────────────────────────────────────
MERCHANT_JWT_SECRET=
BUYER_JWT_SECRET=
HANDOFF_TOKEN_SECRET=
SESSION_COOKIE_DOMAIN=localhost
SESSION_TTL_DAYS=7

# ─── Email (SES) ──────────────────────────────────────────────────────────────
SES_FROM_ADDRESS=no-reply@catalograil.example
SES_REPLY_TO_ADDRESS=support@catalograil.example
SES_CONFIGURATION_SET=

# ─── Public URLs ──────────────────────────────────────────────────────────────
MERCHANT_APP_URL=http://localhost:3000
BUYER_APP_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
MCP_SERVER_URL=http://localhost:4001

# ─── Search tuning ────────────────────────────────────────────────────────────
HNSW_EF_SEARCH=100
SEARCH_CANDIDATE_LIMIT=100
SEARCH_FUSION_LIMIT=30
SEARCH_RRF_K=60
MCP_MAX_RESULTS=5                # rule 6: never more than 5 from an MCP tool

# ─── Adapters (Phase 3) ───────────────────────────────────────────────────────
ADAPTER_TIMEOUT_MS=2000          # rule 12
ADAPTER_CIRCUIT_BREAKER_THRESHOLD=3
