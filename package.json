{
  "name": "catalograil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify:bedrock": "tsx scripts/verify-bedrock.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "db:generate": "pnpm --filter @catalograil/db db:generate",
    "db:migrate": "pnpm --filter @catalograil/db db:migrate",
    "db:seed": "pnpm --filter @catalograil/db db:seed",
    "db:studio": "pnpm --filter @catalograil/db db:studio"
  },
  "devDependencies": {
    "@catalograil/config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@aws-sdk/client-bedrock": "^3.716.0",
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2"
  }
}
