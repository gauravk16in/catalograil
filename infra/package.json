{
  "name": "@catalograil/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK v2 app — one stack per concern",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint bin lib stacks --no-error-on-unmatched-pattern",
    "synth": "cdk synth --context env=dev",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "clean": "rm -rf dist cdk.out .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.173.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@catalograil/config": "workspace:*",
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.173.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
